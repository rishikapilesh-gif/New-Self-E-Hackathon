# Ocean Pulse Environment Configuration

NODE_ENV=development
PORT=3001

# Database: SQLite for zero-config local run, or PostgreSQL connection string for Render
DATABASE_URL="file:./dev.db"

# Security
JWT_SECRET="ocean-pulse-secret-key-hackathon-2026-safe"
SESSION_EXPIRY="7d"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Operational Mode
DEMO_MODE=true
LOG_LEVEL="info"

# Map Provider Configuration
MAP_PROVIDER="leaflet-osm"
MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# GOOGLE_MAPS_API_KEY=

# Environmental & Marine Data Providers (Optional / Fallback to deterministic simulated data)
WEATHER_PROVIDER="simulated"
# WEATHER_API_KEY=
OCEAN_DATA_PROVIDER="simulated"
# OCEAN_DATA_API_KEY=

# AI Copilot Provider (Optional: "openai", "ollama", or "fallback")
AI_PROVIDER="fallback"
AI_ENDPOINT="http://127.0.0.1:11434/api/generate"
AI_MODEL="qwen2.5"
# AI_API_KEY=
